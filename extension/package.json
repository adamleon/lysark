{
  "name": "lysark",
  "displayName": "Lysark",
  "description": "Preview Lysark lecture slides beside the text and edit their 3D scenes from the preview, also in github.dev",
  "version": "0.3.0",
  "publisher": "simply-wyvern",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/adamleon/lysark",
    "directory": "extension"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Visualization",
    "Education"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/extension.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "activationEvents": [],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode the lysark.editorUrl setting from the workspace is ignored; the preview loads from the course homepage.",
      "restrictedConfigurations": [
        "lysark.editorUrl"
      ]
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "lysark.openPreview",
        "title": "Open Lysark Preview",
        "icon": "$(play)"
      },
      {
        "command": "lysark.saveView",
        "title": "Save Camera View into the Slide (V)",
        "category": "Lysark",
        "icon": "$(device-camera)"
      },
      {
        "command": "lysark.sceneActions",
        "title": "Scene Actions…",
        "category": "Lysark",
        "icon": "$(list-selection)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "lysark.openPreview",
          "when": "resourceFilename == slides.md",
          "group": "navigation"
        },
        {
          "command": "lysark.saveView",
          "when": "activeWebviewPanelId == 'lysark.preview'",
          "group": "navigation"
        },
        {
          "command": "lysark.sceneActions",
          "when": "activeWebviewPanelId == 'lysark.preview'",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "lysark.openPreview",
          "when": "resourceFilename == slides.md"
        },
        {
          "command": "lysark.saveView",
          "when": "activeWebviewPanelId == 'lysark.preview'"
        },
        {
          "command": "lysark.sceneActions",
          "when": "activeWebviewPanelId == 'lysark.preview'"
        }
      ]
    },
    "configuration": {
      "title": "Lysark",
      "properties": {
        "lysark.editorUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Where to load the Lysark editor from. Leave empty to use the course's `homepage` in package.json plus `_lysark/editor/`."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node build.mjs",
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "package": "npx --yes @vscode/vsce@3.9.2 package",
    "test-web": "npx --yes @vscode/test-web@0.0.80 --extensionDevelopmentPath=. --browserType=none --port=3000 --coi"
  },
  "devDependencies": {
    "@types/vscode": "1.100.0",
    "esbuild": "0.25.12",
    "typescript": "6.0.3"
  }
}
