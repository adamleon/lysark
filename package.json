{
  "name": "lysark",
  "private": true,
  "version": "2.2.0",
  "description": "Interactive robotics lecture slides: Markdown slides with live three.js robot scenes",
  "type": "module",
  "bin": {
    "lysark": "bin/lysark.mjs"
  },
  "scripts": {
    "dev": "node bin/lysark.mjs dev",
    "build:demo": "node bin/lysark.mjs build demo",
    "check:demo": "node bin/lysark.mjs check dist/demo.html",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "katex": "0.17.0",
    "markdown-it": "14.3.0",
    "pdf-lib": "1.17.1",
    "playwright-core": "1.61.1",
    "three": "0.185.1",
    "uplot": "1.6.32",
    "urdf-loader": "0.13.0",
    "vite": "6.4.3",
    "vite-plugin-singlefile": "2.3.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/katex": "0.16.8",
    "@types/markdown-it": "14.1.2",
    "@types/three": "0.185.0",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
